# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Set to true when running behind a reverse proxy / load balancer (Render, Railway, Nginx)
TRUST_PROXY=false

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://mhrumanpvt_db_user:7s2KVAIMkzJLJgiX@cluster0.axslsdv.mongodb.net/it_solution_builder

# ---------------------------------------------------------------
# Admin authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h

# Used only by `npm run create-admin` (optional; you can pass --email/--password instead)
ADMIN_EMAIL=rumo@gmail.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=Test@123

# ---------------------------------------------------------------
# AI provider
# AI_PROVIDER: openai | anthropic | none
#   none  -> no external AI; a basic keyword summary is shown instead
# AI_BASE_URL: optional, for OpenAI-compatible APIs (Groq, OpenRouter, Azure OpenAI, local LLMs)
# AI_MODEL: optional; defaults are gpt-4o-mini (openai) and claude-haiku-5-5 (anthropic).
#           Check your provider's current model list and set it explicitly.
# ---------------------------------------------------------------
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1500

# ---------------------------------------------------------------
# Email
# EMAIL_TRANSPORT: smtp | json | disabled
#   json  -> development mode: messages are built and logged (recipient + subject) but not delivered
#   smtp  -> real delivery through any SMTP provider (SendGrid, Amazon SES, Brevo, Zoho, Gmail app password)
# ---------------------------------------------------------------
EMAIL_TRANSPORT=json
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cyber Communications <no-reply@example.com>"
EMAIL_REPLY_TO=
# Optional: receives a notification for every new enquiry
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------
# Company details printed on quotations and emails.
# Leave blank anything not confirmed by Cyber Communications.
# ---------------------------------------------------------------
COMPANY_NAME=Cyber Communications
COMPANY_WEBSITE=https://cybercommunications.in
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_GSTIN=

# ---------------------------------------------------------------
# Quotation defaults (admin can change per quotation)
# ---------------------------------------------------------------
QUOTE_CURRENCY=INR
QUOTE_DEFAULT_TAX_RATE=18
QUOTE_VALIDITY_DAYS=15
# Use \n for new lines, or leave blank to use the built-in default terms
QUOTE_DEFAULT_TERMS=
